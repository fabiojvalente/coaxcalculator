<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title data-i18n="title">Coaxial Cable Loss Calculator</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<style>
  #floating_tip {
    position: fixed;
    z-index: 60;
    max-width: 18rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    background: #0f172a;
    color: #f8fafc;
    font-size: 0.75rem;
    line-height: 1.35;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.25);
    pointer-events: none;
  }
  #floating_tip[hidden] { display: none; }
</style>
</head>

<body class="bg-slate-100 min-h-screen text-slate-800">

<script type="application/json" id="cable_data">
{{ cable_json }}
</script>
<script type="application/json" id="i18n_data">
{{ locales_json }}
</script>

<div class="max-w-6xl mx-auto px-4 py-8">

  <!-- Header -->
  <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900" data-i18n="title">Coaxial Cable Loss Calculator</h1>
      <p class="text-slate-500 mt-1" data-i18n="tagline">Compare attenuation and power loss across coax cables.</p>
    </div>
    <div class="shrink-0 sm:text-right">
      <span class="text-sm font-medium text-slate-700" data-i18n="language">Language</span>
      <select id="lang" onchange="setLanguage(this.value)"
              class="mt-1 block w-full sm:w-auto rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        <option value="en">🇬🇧 English</option>
        <option value="pt">🇵🇹 Português</option>
        <option value="it">🇮🇹 Italiano</option>
        <option value="fr">🇫🇷 Français</option>
        <option value="pl">🇵🇱 Polski</option>
        <option value="de">🇩🇪 Deutsch</option>
      </select>
    </div>
  </header>

  <!-- Parameters card (shared across tabs) -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3" data-i18n="parameters">Parameters</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <label class="block sm:col-span-1">
        <span class="text-sm font-medium text-slate-700" data-i18n="freq">Frequency (MHz)</span>
        <input type="number" id="freq" min="0.1" max="10000" step="0.001" value="7.15" oninput="updateBandButtons(); update();"
               class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      </label>
      <div class="block">
        <div class="flex items-center justify-between gap-2">
          <span class="text-sm font-medium text-slate-700" data-i18n="cable_length">Cable length</span>
          <div class="inline-flex rounded-md border border-slate-300 overflow-hidden text-xs font-medium" role="group" data-i18n-aria="length_unit_aria" aria-label="Length unit">
            <button type="button" id="unit_m" onclick="setLengthUnit('m')"
                    class="px-2.5 py-1 transition-colors">m</button>
            <button type="button" id="unit_ft" onclick="setLengthUnit('ft')"
                    class="px-2.5 py-1 border-l border-slate-300 transition-colors">ft</button>
          </div>
        </div>
        <input type="number" id="length" min="0.1" max="10000" step="0.1" value="10" oninput="update();"
               class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      </div>
      <label class="block">
        <span class="text-sm font-medium text-slate-700" data-i18n="power_in">Power in (W)</span>
        <input type="number" id="pwr" min="1" max="1500" step="1" value="100" oninput="update();"
               class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      </label>
    </div>
    <div class="mt-4">
      <span class="text-sm font-medium text-slate-700" data-i18n="amateur_band">Amateur band (mid)</span>
      <div id="band_buttons" class="mt-2 flex flex-wrap gap-1.5"></div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="mb-4 flex border-b border-slate-200" role="tablist" aria-label="Views">
    <button type="button" id="tab_btn_cables" role="tab" aria-selected="true" aria-controls="tab_cables"
            onclick="setTab('cables')"
            class="tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors border-blue-600 text-blue-700">
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/>
      </svg>
      <span data-i18n="tab_cables">Cables</span>
    </button>
    <button type="button" id="tab_btn_graph" role="tab" aria-selected="false" aria-controls="tab_graph"
            onclick="setTab('graph')"
            class="tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors border-transparent text-slate-500 hover:text-slate-800">
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 3v18h18"/><path d="M7 14l4-4 4 3 5-6"/>
      </svg>
      <span data-i18n="tab_graph">Graph</span>
    </button>
  </div>

  <!-- Tab: filters + table -->
  <div id="tab_cables" role="tabpanel" aria-labelledby="tab_btn_cables">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-4">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3" data-i18n="filters">Filters</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-sm font-medium text-slate-700" data-i18n="search">Search</span>
          <input type="search" id="search" data-i18n-placeholder="search_placeholder" placeholder="e.g. RG-213, H155, Ecoflex…" oninput="update();"
                 class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        </label>
        <label class="block">
          <span class="text-sm font-medium text-slate-700" data-i18n="manufacturer">Manufacturer</span>
          <select id="manufacturer" onchange="update();"
                  class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          </select>
        </label>
      </div>
      <p class="text-xs text-slate-400 mt-3" data-i18n="tip">Tip: click a cable in the table to focus it on the graph. Other cables leave the graph until you click them to add. Switch to the Graph tab to compare, or use “Show all” to reset.</p>
    </div>

    <p id="summary" class="text-sm text-slate-500 mb-2"></p>
    <p id="compare_hint" class="hidden text-sm text-slate-600 mb-2"></p>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-600 sticky top-0">
            <tr id="table_header">
              <th data-sort="name" data-i18n="col_cable" class="px-4 py-3 text-left font-semibold cursor-pointer select-none hover:text-slate-900">Cable</th>
              <th data-sort="manufacturer" data-i18n="col_manufacturer" class="px-4 py-3 text-left font-semibold cursor-pointer select-none hover:text-slate-900">Manufacturer</th>
              <th data-sort="att" data-i18n="col_loss_db" class="px-4 py-3 text-right font-semibold cursor-pointer select-none hover:text-slate-900">Loss (dB)</th>
              <th data-sort="s_units"
                  class="px-4 py-3 text-right font-semibold cursor-pointer select-none hover:text-slate-900">
                <span class="inline-flex items-center justify-end gap-1.5">
                  <span data-i18n="col_s_units" class="s-col-label">S levels</span>
                  <button type="button" id="s_levels_help" class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-400 text-[10px] font-bold leading-none text-slate-500 hover:border-slate-700 hover:text-slate-800"
                          aria-label="S levels help">?</button>
                </span>
              </th>
              <th data-sort="loss_percentage" data-i18n="col_loss_pct" class="px-4 py-3 text-right font-semibold cursor-pointer select-none hover:text-slate-900">Loss (%)</th>
              <th data-sort="pwr_out" data-i18n="col_power_out" class="px-4 py-3 text-right font-semibold cursor-pointer select-none hover:text-slate-900">Power out (W)</th>
              <th data-sort="diameter" data-i18n="col_diameter" class="px-4 py-3 text-right font-semibold cursor-pointer select-none hover:text-slate-900 hidden md:table-cell">Ø (mm)</th>
              <th data-sort="vf" data-i18n="col_vf" class="px-4 py-3 text-right font-semibold cursor-pointer select-none hover:text-slate-900 hidden md:table-cell">VF</th>
              <th data-i18n="col_datasheet" class="px-4 py-3 text-center font-semibold">Datasheet</th>
            </tr>
          </thead>
          <tbody id="table_body" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
      <p id="no_results" class="hidden text-center text-slate-400 py-8" data-i18n="no_results">No cables match the current filters.</p>
    </div>
  </div>

  <!-- Tab: graph -->
  <div id="tab_graph" role="tabpanel" aria-labelledby="tab_btn_graph" class="hidden">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-4">
      <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500" data-i18n="chart_title">Loss vs cable length</h2>
        <button type="button" id="btn_show_all" onclick="clearSelection()"
                class="hidden rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50"
                data-i18n="show_all">Show all</button>
      </div>
      <p class="text-xs text-slate-400 mb-2" data-i18n="chart_blurb">
        Solid lines: loss in dB. Dashed lines: power lost in watts (right axis). The vertical dashed line marks your chosen length.
      </p>
      <p id="compare_hint_graph" class="hidden text-sm text-slate-600 mb-3"></p>
      <div class="relative h-80 md:h-[28rem]">
        <canvas id="loss_chart"></canvas>
      </div>
    </div>

    <div id="selected_detail" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hidden">
      <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between gap-2">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500" data-i18n="selected_table_title">Selected cables</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th class="px-4 py-3 text-left font-semibold" data-i18n="col_cable">Cable</th>
              <th class="px-4 py-3 text-left font-semibold" data-i18n="col_manufacturer">Manufacturer</th>
              <th class="px-4 py-3 text-right font-semibold" data-i18n="col_loss_db">Loss (dB)</th>
              <th class="px-4 py-3 text-right font-semibold" data-i18n="col_s_units">S levels</th>
              <th class="px-4 py-3 text-right font-semibold" data-i18n="col_loss_pct">Loss (%)</th>
              <th class="px-4 py-3 text-right font-semibold" data-i18n="col_power_lost">Power lost (W)</th>
              <th class="px-4 py-3 text-right font-semibold" data-i18n="col_power_out">Power out (W)</th>
            </tr>
          </thead>
          <tbody id="selected_table_body" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
      <p id="selected_empty" class="hidden text-center text-slate-400 py-6 text-sm" data-i18n="selected_empty">Select cables in the Cables tab to see details here.</p>
    </div>
  </div>

  <!-- Footer / credits -->
  <footer class="mt-6 text-center text-xs text-slate-400 space-y-1">
    <p>
      <span data-i18n="footer_fork">This project is a fork of</span>
      <a href="https://github.com/olgierd/coaxcalculator" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline">olgierd/coaxcalculator</a>.
      <span data-i18n="footer_credit">All credit for the original idea, implementation, and cable data goes to</span>
      <a href="https://github.com/olgierd" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline">Olgierd</a>.
    </p>
    <p>
      <a href="https://github.com/olgierd/coaxcalculator/blob/main/README.md" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline" data-i18n="how_it_works">How it works</a>
      ·
      <a href="https://github.com/olgierd/coaxcalculator/blob/main/README_pl.md" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline">Jak to działa</a>
    </p>
  </footer>

</div>

<div id="floating_tip" hidden role="tooltip"></div>

<script>
  var cables = JSON.parse(document.getElementById('cable_data').innerHTML);
  var locales = JSON.parse(document.getElementById('i18n_data').innerHTML);
  var LANG_KEY = "coaxcalc-lang";
  var SUPPORTED_LANGS = ["en", "pt", "it", "fr", "pl", "de"];
  var current_lang = "en";

  var selected = [];
  var sort_state = { column: "att", ascending: true };
  var loss_chart = null;
  var length_unit = "m";   // "m" or "ft"
  var FT_PER_M = 3.280839895;
  var DB_PER_S_UNIT = 6;
  var last_sorted_rows = [];
  var current_tab = "cables";

  function setTab(tab) {
    current_tab = (tab === "graph") ? "graph" : "cables";
    var cablesPanel = document.getElementById("tab_cables");
    var graphPanel = document.getElementById("tab_graph");
    var cablesBtn = document.getElementById("tab_btn_cables");
    var graphBtn = document.getElementById("tab_btn_graph");

    var active = "tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors border-blue-600 text-blue-700";
    var inactive = "tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors border-transparent text-slate-500 hover:text-slate-800";

    if (current_tab === "cables") {
      cablesPanel.classList.remove("hidden");
      graphPanel.classList.add("hidden");
      cablesBtn.className = active;
      graphBtn.className = inactive;
      cablesBtn.setAttribute("aria-selected", "true");
      graphBtn.setAttribute("aria-selected", "false");
    } else {
      cablesPanel.classList.add("hidden");
      graphPanel.classList.remove("hidden");
      cablesBtn.className = inactive;
      graphBtn.className = active;
      cablesBtn.setAttribute("aria-selected", "false");
      graphBtn.setAttribute("aria-selected", "true");
      // Chart was sized while hidden — force a correct layout pass
      if (loss_chart) {
        requestAnimationFrame(function() {
          loss_chart.resize();
          loss_chart.update("none");
        });
      }
    }
  }

  function detectLanguage() {
    try {
      var saved = localStorage.getItem(LANG_KEY);
      if (saved && SUPPORTED_LANGS.includes(saved)) return saved;
    } catch (e) {}

    var candidates = [];
    if (navigator.languages && navigator.languages.length) {
      for (var i = 0; i < navigator.languages.length; i++) {
        candidates.push(navigator.languages[i]);
      }
    } else if (navigator.language || navigator.userLanguage) {
      candidates.push(navigator.language || navigator.userLanguage);
    }

    for (var j = 0; j < candidates.length; j++) {
      var prefix = String(candidates[j]).toLowerCase().split("-")[0];
      if (SUPPORTED_LANGS.includes(prefix)) return prefix;
    }
    return "en";
  }

  function t(key, vars) {
    var dict = locales[current_lang] || locales.en;
    var str = (dict && dict[key]) || (locales.en && locales.en[key]) || key;
    if (vars) {
      Object.keys(vars).forEach(function(k) {
        str = str.replace(new RegExp("\\{" + k + "\\}", "g"), vars[k]);
      });
    }
    return str;
  }

  function applyI18n() {
    document.documentElement.lang = current_lang;
    document.querySelectorAll("[data-i18n]").forEach(function(el) {
      var key = el.getAttribute("data-i18n");
      // Preserve sort arrows on table headers — update() refreshes those
      if (el.closest("#table_header") && el.hasAttribute("data-sort")) {
        el.textContent = t(key);
        return;
      }
      el.textContent = t(key);
    });
    document.querySelectorAll("[data-i18n-placeholder]").forEach(function(el) {
      el.placeholder = t(el.getAttribute("data-i18n-placeholder"));
    });
    document.querySelectorAll("[data-i18n-title]").forEach(function(el) {
      el.title = t(el.getAttribute("data-i18n-title"));
    });
    document.querySelectorAll("[data-i18n-aria]").forEach(function(el) {
      el.setAttribute("aria-label", t(el.getAttribute("data-i18n-aria")));
    });
    var allOpt = document.querySelector("#manufacturer option[value='']");
    if (allOpt) allOpt.text = t("all_manufacturers");
    update();
  }

  function setLanguage(lang) {
    if (!SUPPORTED_LANGS.includes(lang)) lang = "en";
    current_lang = lang;
    try { localStorage.setItem(LANG_KEY, lang); } catch (e) {}
    var select = document.getElementById("lang");
    if (select) select.value = lang;
    applyI18n();
  }

  function lengthToMeters(value, unit) {
    return unit === "ft" ? value / FT_PER_M : value;
  }

  function metersToUnit(meters, unit) {
    return unit === "ft" ? meters * FT_PER_M : meters;
  }

  function setLengthUnit(unit) {
    if (unit === length_unit) return;
    var input = document.getElementById("length");
    var val = parseFloat(input.value);
    if (!isNaN(val)) {
      var meters = lengthToMeters(val, length_unit);
      var converted = metersToUnit(meters, unit);
      input.value = (Math.round(converted * 10) / 10);
    }
    length_unit = unit;
    updateLengthUnitUI();
    update();
  }

  function updateLengthUnitUI() {
    var active = "bg-blue-600 text-white";
    var inactive = "bg-white text-slate-700 hover:bg-slate-50";
    document.getElementById("unit_m").className =
      "px-2.5 py-1 transition-colors " + (length_unit === "m" ? active : inactive);
    document.getElementById("unit_ft").className =
      "px-2.5 py-1 border-l border-slate-300 transition-colors " + (length_unit === "ft" ? active : inactive);
  }

  // stable, distinct color per cable key
  function colorForKey(key) {
    var hash = 0;
    for (var i = 0; i < key.length; i++) {
      hash = (hash * 31 + key.charCodeAt(i)) >>> 0;
    }
    var hue = hash % 360;
    return "hsl(" + hue + ", 70%, 45%)";
  }

  // plugin drawing a dashed vertical line at the user's chosen length
  var lengthLinePlugin = {
    id: 'lengthLine',
    afterDatasetsDraw(chart) {
      var cfg = chart.options.plugins.lengthLine || {};
      var length = cfg.length;
      var unit = cfg.unit || "m";
      if (!length && length !== 0) return;

      var xScale = chart.scales.x;
      var yScale = chart.scales.y;
      if (length < xScale.min || length > xScale.max) return;

      var xPix = xScale.getPixelForValue(length);
      var ctx = chart.ctx;

      ctx.save();
      ctx.beginPath();
      ctx.setLineDash([6, 4]);
      ctx.strokeStyle = "rgba(15, 23, 42, 0.6)";
      ctx.lineWidth = 1.5;
      ctx.moveTo(xPix, yScale.top);
      ctx.lineTo(xPix, yScale.bottom);
      ctx.stroke();
      ctx.setLineDash([]);

      // label
      var label = length + " " + unit;
      ctx.font = "600 11px sans-serif";
      var textWidth = ctx.measureText(label).width;
      var tx = Math.min(xPix + 6, xScale.right - textWidth - 4);
      ctx.fillStyle = "rgba(15, 23, 42, 0.75)";
      ctx.fillText(label, tx, yScale.top + 12);
      ctx.restore();
    }
  };

  function buildCableRow(key, params) {
    var cable = cables[key];
    if (!cable) return null;
    var info = cable.additional_info || {};
    var cur = {
      key: key,
      name: cable.name,
      manufacturer: cable.manufacturer || "—",
      att100m: get_att_for_freq(cable["attenuation"], params.freq),
      link: cable.data_source,
      diameter: (info.ext_diameter_mm !== undefined) ? info.ext_diameter_mm : null,
      vf: (info.velocity_factor !== undefined) ? info.velocity_factor : null
    };
    var row = Object.assign({}, cur, generateOutputStrings(cur, params));
    row.sort_values = {
      name: row.name,
      manufacturer: cable.manufacturer || null,
      att: row.att_num,
      s_units: row.s_units_num,
      loss_percentage: row.loss_percentage_num,
      pwr_out: row.pwr_out_num,
      diameter: row.diameter,
      vf: row.vf
    };
    return row;
  }

  function wattsLostFromDb(db, pwr_in) {
    if (!(pwr_in > 0) || db === null || db === undefined) return null;
    var pwr_out = Math.pow(10, Math.log10(pwr_in) - db / 10);
    return pwr_in - pwr_out;
  }

  function rowsForChart(filteredRows, params) {
    // After the first pick → always plot every selected cable, even if search/filters hide them in the table.
    if (selected.length > 0) {
      return selected.map(function(key) {
        return buildCableRow(key, params);
      }).filter(function(o) {
        return o && o.att100m < 10000;
      });
    }
    return filteredRows.filter(function(o) { return o.att100m < 10000; });
  }

  function onChartSelect(cableKey) {
    if (!cableKey) return;
    toggleSelect(cableKey);
  }

  function renderChart(rows, params) {
    if (typeof Chart === 'undefined') return;   // CDN unavailable

    var unit = params.length_unit;
    // chart x-axis is in the display unit; attenuation data is per 100 m
    var display_length = params.length_display;
    var xmin_span = 100;  // at least 100 of the current unit
    var xmax = Math.max(xmin_span, Math.ceil(display_length * 1.2));
    var steps = 20;
    var meters_per_display = (unit === "ft") ? (1 / FT_PER_M) : 1;
    var pwr_in = params.pwr_in;

    var chartRows = rowsForChart(rows, params);
    var comparing = selected.length > 0;
    // Dual-axis watts lines only when comparing a few cables (avoids clutter)
    var showWatts = comparing;

    var datasets = [];
    chartRows.forEach(function(o) {
      var dbPoints = [];
      var wattPoints = [];
      for (var i = 0; i <= steps; i++) {
        var x = xmax * i / steps;
        var meters = x * meters_per_display;
        var db = o.att100m * meters / 100;
        dbPoints.push({ x: x, y: db });
        if (showWatts) {
          wattPoints.push({ x: x, y: wattsLostFromDb(db, pwr_in) });
        }
      }
      datasets.push({
        label: o.name,
        cableKey: o.key,
        metric: "db",
        data: dbPoints,
        yAxisID: "y",
        borderColor: colorForKey(o.key),
        backgroundColor: colorForKey(o.key),
        borderWidth: comparing ? 3 : 1.5,
        borderDash: [],
        pointRadius: 0,
        pointHitRadius: 8,
        tension: 0
      });
      if (showWatts) {
        datasets.push({
          label: o.name + " (W)",
          cableKey: o.key,
          metric: "watts",
          data: wattPoints,
          yAxisID: "y1",
          borderColor: colorForKey(o.key),
          backgroundColor: colorForKey(o.key),
          borderWidth: 2,
          borderDash: [6, 4],
          pointRadius: 0,
          pointHitRadius: 8,
          tension: 0
        });
      }
    });

    var config_data = { datasets: datasets };
    var options = {
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      interaction: { mode: 'nearest', intersect: false },
      onClick: function(evt, elements) {
        if (!elements.length) return;
        var ds = this.data.datasets[elements[0].datasetIndex];
        if (ds && ds.cableKey) onChartSelect(ds.cableKey);
      },
      scales: {
        x: {
          type: 'linear',
          min: 0,
          max: xmax,
          title: { display: true, text: t("chart_x", { unit: unit }) }
        },
        y: {
          type: 'linear',
          position: 'left',
          min: 0,
          title: { display: true, text: t("chart_y", { freq: params.freq }) }
        },
        y1: {
          type: 'linear',
          position: 'right',
          min: 0,
          display: showWatts,
          grid: { drawOnChartArea: false },
          title: { display: showWatts, text: t("chart_y_watts") }
        }
      },
      plugins: {
        lengthLine: { length: display_length, unit: unit },
        legend: {
          position: 'bottom',
          labels: {
            boxWidth: 12,
            boxHeight: 12,
            font: { size: 10 },
            filter: function(item, chartData) {
              var ds = chartData.datasets[item.datasetIndex];
              return !ds || ds.metric !== "watts";
            }
          },
          onClick: function(e, legendItem, legend) {
            var ds = legend.chart.data.datasets[legendItem.datasetIndex];
            if (ds && ds.cableKey) onChartSelect(ds.cableKey);
          }
        },
        tooltip: {
          callbacks: {
            title: function(items) { return items.length ? items[0].parsed.x.toFixed(0) + " " + unit : ""; },
            label: function(item) {
              var ds = item.dataset;
              var name = ds.label.replace(/ \(W\)$/, "");
              if (ds.metric === "watts") {
                return name + ": " + item.parsed.y.toFixed(2) + " W " + t("chart_lost_suffix");
              }
              var db = item.parsed.y;
              var lost = wattsLostFromDb(db, pwr_in);
              var line = name + ": " + db.toFixed(2) + " dB";
              if (lost !== null) {
                line += " · " + lost.toFixed(2) + " W " + t("chart_lost_suffix");
              }
              return line;
            }
          }
        }
      }
    };

    if (loss_chart) {
      loss_chart.data = config_data;
      loss_chart.options = options;
      loss_chart.update();
    }
    else {
      loss_chart = new Chart(document.getElementById('loss_chart'), {
        type: 'line',
        data: config_data,
        options: options,
        plugins: [lengthLinePlugin]
      });
    }
  }

  function renderSelectedDetail(params) {
    var panel = document.getElementById("selected_detail");
    var tbody = document.getElementById("selected_table_body");
    var empty = document.getElementById("selected_empty");
    if (!panel || !tbody) return;

    var hasSelection = selected.length > 0;
    panel.classList.toggle("hidden", !hasSelection);
    if (!hasSelection) {
      tbody.innerHTML = "";
      return;
    }

    var rows = selected.map(function(key) { return buildCableRow(key, params); }).filter(Boolean);
    tbody.innerHTML = "";
    empty.classList.toggle("hidden", rows.length > 0);

    rows.forEach(function(o) {
      var tr = document.createElement("tr");
      tr.className = "bg-amber-50/50";
      var lost = (o.pwr_out_num !== null && o.pwr_out_num !== undefined)
        ? (params.pwr_in - o.pwr_out_num)
        : null;
      var cells = [
        { html: '<span class="font-medium text-slate-900">' + o.name + '</span>', cls: "px-4 py-2.5 text-left" },
        { html: o.manufacturer, cls: "px-4 py-2.5 text-left text-slate-500" },
        { html: o.att, cls: "px-4 py-2.5 text-right tabular-nums font-medium" },
        { html: o.s_units, cls: "px-4 py-2.5 text-right tabular-nums" },
        { html: o.loss_percentage, cls: "px-4 py-2.5 text-right tabular-nums" },
        { html: lost !== null ? (Math.round(lost * 100) / 100).toFixed(2) : "—", cls: "px-4 py-2.5 text-right tabular-nums" },
        { html: o.pwr_out, cls: "px-4 py-2.5 text-right tabular-nums" }
      ];
      cells.forEach(function(c) {
        var td = document.createElement("td");
        td.className = c.cls;
        td.innerHTML = c.html;
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
  }

  function populateManufacturers() {
    var manufacturers = [];
    for (var key in cables) {
      if(cables[key].manufacturer && !manufacturers.includes(cables[key].manufacturer)) {
        manufacturers.push(cables[key].manufacturer);
      }
    }
    manufacturers.sort(function(a, b) { return a.toLowerCase().localeCompare(b.toLowerCase()); });

    var select = document.getElementById('manufacturer');
    select.innerHTML = "";
    var all_option = document.createElement('option');
    all_option.value = "";
    all_option.text = t("all_manufacturers");
    select.appendChild(all_option);

    manufacturers.forEach(m => {
      var option = document.createElement('option');
      option.value = m;
      option.text = m;
      select.appendChild(option);
    });
  }

  // Mid-band frequencies for common amateur allocations
  var AMATEUR_BANDS = [
    { label: "160m", mhz: 1.900 },
    { label: "80m",  mhz: 3.750 },
    { label: "60m",  mhz: 5.357 },
    { label: "40m",  mhz: 7.150 },
    { label: "30m",  mhz: 10.125 },
    { label: "20m",  mhz: 14.175 },
    { label: "17m",  mhz: 18.118 },
    { label: "15m",  mhz: 21.225 },
    { label: "12m",  mhz: 24.940 },
    { label: "10m",  mhz: 28.850 },
    { label: "6m",   mhz: 52.000 },
    { label: "4m",   mhz: 70.200 },
    { label: "2m",   mhz: 145.000 },
    { label: "70cm", mhz: 435.000 },
    { label: "23cm", mhz: 1296.000 }
  ];

  function setBandFrequency(mhz) {
    document.getElementById('freq').value = mhz;
    updateBandButtons();
    update();
  }

  function populateBandButtons() {
    var container = document.getElementById('band_buttons');
    AMATEUR_BANDS.forEach(function(band) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.mhz = band.mhz;
      btn.textContent = band.label;
      btn.title = band.mhz + " MHz";
      btn.className = "band-btn rounded-md border px-2.5 py-1 text-xs font-medium transition-colors";
      btn.onclick = function() { setBandFrequency(band.mhz); };
      container.appendChild(btn);
    });
    updateBandButtons();
  }

  function updateBandButtons() {
    var freq = parseFloat(document.getElementById('freq').value);
    document.querySelectorAll('.band-btn').forEach(function(btn) {
      var active = Math.abs(parseFloat(btn.dataset.mhz) - freq) < 0.0005;
      btn.className = "band-btn rounded-md border px-2.5 py-1 text-xs font-medium transition-colors " +
        (active
          ? "border-blue-600 bg-blue-600 text-white"
          : "border-slate-300 bg-white text-slate-700 hover:border-blue-400 hover:bg-blue-50");
    });
  }

  function get_att_for_freq(att_data, frequency) {

    att_array = Object.entries(att_data).sort(function(a,b) { return a[0] - b[0];}); // convert dictionary to an array of pairs and sort by frequency

    // frequency higher than last data point specified
    if(frequency > att_array[att_array.length - 1][0]) {
      return 10000;
    }

    // spot-on hit - no interpolation needed
    if(frequency in att_data) {
      return att_data[frequency];
    }

    // find two neighboring values
    for(var i = 0; i < att_array.length;i++) {
      if(att_array[i][0] > frequency) {
        if(i>=1) {
          lower = att_array[i-1];
        }
        else {
          lower = [0, 0];   // use 0 dB @ 0 MHz, if frequency is below the first data point
        }
        upper = att_array[i];
        break;
      }
    }

    // simple linear interpolation between two points
    return (frequency-lower[0])/(upper[0]-lower[0])*(upper[1]-lower[1])+lower[1];

  }

  function sortRows(rows) {
    var col = sort_state.column;
    var dir = sort_state.ascending ? 1 : -1;

    return rows.sort(function(a, b) {
      var va = a.sort_values[col];
      var vb = b.sort_values[col];

      // missing values always go last
      var a_missing = (va === null || va === undefined || va === "");
      var b_missing = (vb === null || vb === undefined || vb === "");
      if(a_missing && b_missing) return 0;
      if(a_missing) return 1;
      if(b_missing) return -1;

      if(typeof va === "string") {
        return dir * va.toLowerCase().localeCompare(vb.toLowerCase());
      }
      return dir * (va - vb);
    });
  }

  function generateOutputStrings(cable_data, params) {
    output = {
      att: "—",
      pwr_out: "—",
      loss_percentage: "—",
      s_units: "—",
      att_num: null,
      pwr_out_num: null,
      loss_percentage_num: null,
      s_units_num: null
    }

    if(cable_data.att100m < 10000) {
      // calculate output power & percentage loss
      output.att_num = cable_data.att100m * params.length/100;
      output.pwr_out_num = 10**(Math.log10(params.pwr_in)-output.att_num/10);
      output.loss_percentage_num = 100-10**(Math.log10(100)-output.att_num/10);
      output.s_units_num = output.att_num / DB_PER_S_UNIT;

      // round and change to strings
      output.att = (Math.round(output.att_num*100)/100).toFixed(2);
      output.pwr_out = (Math.round(output.pwr_out_num*100)/100).toFixed(2);
      output.loss_percentage = (Math.round(output.loss_percentage_num*10)/10).toFixed(1);
      output.s_units = (Math.round(output.s_units_num*10)/10).toFixed(1);
    }

    return output;
  }

  function toggleSelect(key) {
    if(!selected.includes(key)) {
      selected.push(key);
    }
    else {
      selected.splice(selected.indexOf(key), 1);
    }

    update();
  }

  function clearSelection() {
    selected = [];
    update();
  }

  function setSort(column) {
    if(sort_state.column === column) {
      sort_state.ascending = !sort_state.ascending;
    }
    else {
      sort_state.column = column;
      sort_state.ascending = true;
    }
    update();
  }

  function updateHeaderIndicators() {
    document.querySelectorAll('#table_header th[data-sort]').forEach(th => {
      var key = th.getAttribute("data-i18n");
      var labelEl = th.querySelector(".s-col-label");
      var base;
      if (labelEl) {
        base = t("col_s_units");
      } else if (key) {
        base = t(key);
      } else {
        base = th.textContent.replace(/[\u25B2\u25BC]\s*$/, '').trim();
      }
      var arrow = (th.dataset.sort === sort_state.column)
        ? (sort_state.ascending ? " \u25B2" : " \u25BC")
        : "";
      if (labelEl) {
        labelEl.textContent = base + arrow;
      } else {
        th.textContent = base + arrow;
      }
    });
  }

  function positionFloatingTip(anchor) {
    var tip = document.getElementById("floating_tip");
    if (!tip || tip.hidden) return;
    var rect = anchor.getBoundingClientRect();
    var tipRect = tip.getBoundingClientRect();
    var left = Math.min(
      Math.max(8, rect.right - tipRect.width),
      window.innerWidth - tipRect.width - 8
    );
    var top = rect.bottom + 8;
    if (top + tipRect.height > window.innerHeight - 8) {
      top = Math.max(8, rect.top - tipRect.height - 8);
    }
    tip.style.left = left + "px";
    tip.style.top = top + "px";
  }

  function showSLevelsTip(anchor) {
    var tip = document.getElementById("floating_tip");
    tip.textContent = t("col_s_units_title");
    tip.hidden = false;
    positionFloatingTip(anchor);
  }

  function hideSLevelsTip() {
    document.getElementById("floating_tip").hidden = true;
  }

  function bindSLevelsHelp() {
    var btn = document.getElementById("s_levels_help");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("mouseenter", function() { showSLevelsTip(btn); });
    btn.addEventListener("mouseleave", hideSLevelsTip);
    btn.addEventListener("focus", function() { showSLevelsTip(btn); });
    btn.addEventListener("blur", hideSLevelsTip);
    btn.addEventListener("click", function(e) {
      e.stopPropagation(); // don't trigger column sort
      var tip = document.getElementById("floating_tip");
      if (tip.hidden) showSLevelsTip(btn);
      else hideSLevelsTip();
    });
    window.addEventListener("scroll", function() {
      var tip = document.getElementById("floating_tip");
      if (!tip.hidden) positionFloatingTip(btn);
    }, true);
  }

  function update() {

    var length_display = parseFloat(document.getElementById('length').value);

    // read input parameters — calculations always use metres
    params = {
      "freq": parseFloat(document.getElementById('freq').value),
      "length": lengthToMeters(length_display, length_unit),
      "length_display": length_display,
      "length_unit": length_unit,
      "pwr_in": parseFloat(document.getElementById('pwr').value),
      "manufacturer": document.getElementById('manufacturer').value,
      "search": document.getElementById('search').value.trim().toLowerCase()
    };

    var rows = [];

    // calculate attenuation for a given freq for every cable (/100 m)
    for (var key in cables) {
      var cable = cables[key];

      // skip cables from other manufacturers, if a filter is set
      if(params.manufacturer && cable.manufacturer != params.manufacturer) {
        continue;
      }

      // free-text search on name, manufacturer and type
      if(params.search) {
        var haystack = [cable.name, cable.manufacturer, cable.type].join(" ").toLowerCase();
        if(!haystack.includes(params.search)) {
          continue;
        }
      }

      rows.push(buildCableRow(key, params));
    }

    var sorted_rows = sortRows(rows);
    last_sorted_rows = sorted_rows;

    // summary line
    document.getElementById('summary').textContent = t("summary", {
      freq: params.freq,
      length: params.length_display,
      unit: params.length_unit,
      power: params.pwr_in,
      count: sorted_rows.length
    });

    var comparing = selected.length > 0;
    var showAllBtn = document.getElementById("btn_show_all");
    if (showAllBtn) showAllBtn.classList.toggle("hidden", !comparing);

    var hintText = comparing ? t("compare_hint", { count: selected.length }) : "";
    ["compare_hint", "compare_hint_graph"].forEach(function(id) {
      var hint = document.getElementById(id);
      if (!hint) return;
      hint.classList.toggle("hidden", !comparing);
      if (comparing) hint.textContent = hintText;
    });

    var tbody = document.getElementById('table_body');
    tbody.innerHTML = '';

    document.getElementById('no_results').classList.toggle('hidden', sorted_rows.length > 0);

    var sTitle = t("col_s_units_title");

    sorted_rows.forEach(o => {
      var tr = document.createElement('tr');
      tr.id = o.key;
      var isOnGraph = selected.includes(o.key);
      if (isOnGraph) {
        tr.className = "cursor-pointer transition-colors bg-amber-100 hover:bg-amber-200";
      } else if (comparing) {
        tr.className = "cursor-pointer transition-colors opacity-40 hover:opacity-70 hover:bg-slate-50";
        tr.title = t("add_to_graph");
      } else {
        tr.className = "cursor-pointer transition-colors hover:bg-slate-50";
      }
      tr.onclick = function(event) {
        // don't toggle selection when clicking the datasheet link
        if(event.target.tagName === 'A') return;
        toggleSelect(o.key);
      };

      var cells = [
        { html: '<span class="font-medium text-slate-900">' + o.name + '</span>', cls: "px-4 py-2.5 text-left" },
        { html: o.manufacturer, cls: "px-4 py-2.5 text-left text-slate-500" },
        { html: o.att, cls: "px-4 py-2.5 text-right tabular-nums font-medium" },
        { html: o.s_units, cls: "px-4 py-2.5 text-right tabular-nums", title: sTitle },
        { html: o.loss_percentage, cls: "px-4 py-2.5 text-right tabular-nums" },
        { html: o.pwr_out, cls: "px-4 py-2.5 text-right tabular-nums" },
        { html: (o.diameter !== null ? o.diameter : "—"), cls: "px-4 py-2.5 text-right tabular-nums text-slate-500 hidden md:table-cell" },
        { html: (o.vf !== null ? o.vf : "—"), cls: "px-4 py-2.5 text-right tabular-nums text-slate-500 hidden md:table-cell" },
        { html: o.link
            ? '<a href="' + o.link + '" target="_blank" rel="noopener noreferrer" class="inline-block rounded-md bg-blue-50 text-blue-700 px-2 py-0.5 text-xs font-medium hover:bg-blue-100">pdf</a>'
            : "—",
          cls: "px-4 py-2.5 text-center" }
      ];

      cells.forEach(c => {
        var td = document.createElement('td');
        td.className = c.cls;
        td.innerHTML = c.html;
        if (c.title) td.title = c.title;
        tr.appendChild(td);
      });

      tbody.appendChild(tr);
    });

    updateHeaderIndicators();
    renderSelectedDetail(params);

    try {
      renderChart(sorted_rows, params);
    } catch (err) {
      console.error("Chart render failed:", err);
    }

  }

  document.querySelectorAll('#table_header th[data-sort]').forEach(th => {
    th.addEventListener('click', function() { setSort(th.dataset.sort); });
  });

  current_lang = detectLanguage();
  document.getElementById("lang").value = current_lang;
  populateManufacturers();
  populateBandButtons();
  updateLengthUnitUI();
  bindSLevelsHelp();
  applyI18n();

</script>

</body>
</html>
